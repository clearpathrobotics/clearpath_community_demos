<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pink_kinematics_server</name>
  <version>0.0.0</version>
  <description>Node that runs the pink IK solver</description>
  <maintainer email="stephanie.eng@rockwellautomation.com">Robotics Center of Excellence</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>generate_parameter_library</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>rosidl_default_runtime</depend>
  <depend>rclpy</depend>

  <!-- Not in Rosdistro, but required, installed via Dockerfile via pip -->
  <!-- <depend>python3-pinocchio</depend> -->
  <!-- <depend>python3-pink</depend> -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
