<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reachback">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import reachback urdf file -->
    <xacro:include filename="$(find reachback_description)/urdf/reachback.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="reachback.ros2_control.xacro" />


    <xacro:reachback_ros2_control name="reachback_arms" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
