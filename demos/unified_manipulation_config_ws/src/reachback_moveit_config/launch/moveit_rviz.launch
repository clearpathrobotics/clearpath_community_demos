<?xml version="1.0"?>
<launch>

  <!-- Use robot description from moveit_config as it has ros2_control tags for the arms -->
  <let name="xacro" value="$(find-pkg-prefix xacro)/bin/xacro" />
  <let name="reachback_moveit_config" value="$(find-pkg-share reachback_moveit_config)" />
  <let name="robot_description" value="$(command '$(var xacro) $(var reachback_moveit_config)/config/reachback.urdf.xacro')" />
  <let name="robot_description_semantic" value="$(command 'xacro $(var reachback_moveit_config)/config/reachback.srdf')" />

  <!-- Launch arguments -->
  <arg name="rviz_config" default="$(var reachback_moveit_config)/config/moveit.rviz" description="Path to RViz config file" />
  <arg name="kinematics_config" default="$(var reachback_moveit_config)/config/kinematics.yaml" description="Path to kinematics configuration file" />
  <arg name="executeTaskSolutionCapability" default="False" description="Whether to include the ExecuteTaskSolution capability in the MoveGroup node" />
  <arg name="launch_rviz" default="True" description="Whether to launch RViz" />

  <!-- Publish the robot description -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" type="str" value="$(var robot_description)" />
  </node>

  <include file="$(find-pkg-share pink_kinematics_server)/launch/pink_kinematics_server.launch" />

  <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config)" if="$(var launch_rviz)">
      <param name="robot_description" value="$(var robot_description)" type="str" />
      <param name="robot_description_semantic" value="$(var robot_description_semantic)" type="str" />
      <param from="$(var reachback_moveit_config)/config/kinematics.yaml" />
  </node>

  <node pkg="moveit_ros_move_group" exec="move_group" output="screen" if="$(var executeTaskSolutionCapability)">
      <param name="robot_description" value="$(var robot_description)" type="str" />
      <param name="robot_description_semantic" value="$(var robot_description_semantic)" type="str" />
      <param from="$(var reachback_moveit_config)/config/cartesian_limits.yaml" />
      <param from="$(var kinematics_config)" />
      <param from="$(var reachback_moveit_config)/config/ompl_planning.yaml" />
      <param from="$(var reachback_moveit_config)/config/planning_pipelines.yaml" />
      <param from="$(var reachback_moveit_config)/config/moveit_controllers.yaml" />
      <param from="$(var reachback_moveit_config)/config/joint_limits.yaml" />
      <param name="publish_planning_scene" value="True" />
      <param name="publish_geometry_updates" value="True" />
      <param name="publish_state_updates" value="True" />
      <param name="publish_transforms_updates" value="True" />
      <param name="get_planning_scene_service" value="True" />
      <param name="capabilities" value="move_group/ExecuteTaskSolutionCapability" />
  </node>

  <node pkg="moveit_ros_move_group" exec="move_group" output="screen" unless="$(var executeTaskSolutionCapability)">
      <param name="robot_description" value="$(var robot_description)" type="str" />
      <param name="robot_description_semantic" value="$(var robot_description_semantic)" type="str" />
      <param from="$(var reachback_moveit_config)/config/cartesian_limits.yaml" />
      <param from="$(var kinematics_config)" />
      <param from="$(var reachback_moveit_config)/config/ompl_planning.yaml" />
      <param from="$(var reachback_moveit_config)/config/planning_pipelines.yaml" />
      <param from="$(var reachback_moveit_config)/config/moveit_controllers.yaml" />
      <param from="$(var reachback_moveit_config)/config/joint_limits.yaml" />
      <param name="publish_planning_scene" value="True" />
      <param name="publish_geometry_updates" value="True" />
      <param name="publish_state_updates" value="True" />
      <param name="publish_transforms_updates" value="True" />
  </node>

  <node pkg="controller_manager" exec="ros2_control_node" output="screen">
      <param name="robot_description" value="$(var robot_description)" type="str" />
      <param from="$(var reachback_moveit_config)/config/ros2_controllers.yaml" />
      <remap from="mecanum_drive_controller/tf_odometry" to="tf" />
  </node>

  <!-- Spawn ros2_control controllers -->
  <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster -c /controller_manager" />
  <node pkg="controller_manager" exec="spawner" args="arm_controller -c /controller_manager" />
  <node pkg="controller_manager" exec="spawner" args="gripper_controller -c /controller_manager" />
  <node pkg="controller_manager" exec="spawner" args="-c /controller_manager --activate-as-group mecanum_drive_controller base_joint_to_twist_controller base_joint_controller" />
</launch>
